# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/warranty-manager?retryWrites=true&w=majority

# ─── Server ──────────────────────────────────────────────────────────────────
# The Vite dev proxy in frontend/vite.config.ts expects port 3000.
NODE_ENV=development
PORT=3000

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET is REQUIRED in production — the API refuses to start without it.
JWT_SECRET=

# Guards the daily cron job and the service-center seed endpoint.
# Both reject every request when this is unset.
CRON_SECRET=

# ─── AI (claim assistant, diagnostic chat, receipt reading) ──────────────────
# Free key from https://aistudio.google.com/apikey
# Receipt scanning uses the vision model, so this is the only key it needs.
GEMINI_API_KEY=
# Optional model overrides (defaults: gemini-flash-latest / gemini-3.1-flash-lite)
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# ─── Email (expiry alerts, password reset, claim emails) ─────────────────────
# Key from https://resend.com/api-keys
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=onboarding@resend.dev

